rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'QW3iPpCmUEVTvZFFoD4aD5idwhY2';
    }
    match /settings/display { allow read: if true; allow write: if isAdmin(); }
    match /messages/{messageId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /messageTemplates/{templateId} { allow read, create, update, delete: if isAdmin(); }
    match /presentations/{presentationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }
    match /displayStatus/main {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeen','version'])
        && request.resource.data.version is string
        && request.resource.data.lastSeen == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
